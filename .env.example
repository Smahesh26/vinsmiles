# Google Business Profile API configuration
# Add these values in Vercel Project Settings -> Environment Variables.

# OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id

# OAuth client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth refresh token for the Google account that manages the business profile
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Business Profile account ID (GBP account resource identifier)
GOOGLE_BUSINESS_ACCOUNT_ID=your_google_business_account_id

# Business Profile location ID (specific location resource identifier)
GOOGLE_BUSINESS_LOCATION_ID=your_google_business_location_id